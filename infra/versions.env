# AI-Native Data Platform - pinned version manifest (M0 freeze)
# Verified 2026-09-14 against the upstream registries from the target machine.
# Rule: no `latest`, `master`, `nightly` or invented tags. Every tag below was
# resolved to an existing artifact; digests are recorded after a real pull
# (see docs/compatibility.md for status per item).

# --- Languages / toolchain ---
PYTHON_VERSION=3.11.15
NODE_VERSION=24.21.0
NPM_VERSION=11.6.2
UV_VERSION=0.11.16

# --- Business runtime images (pinned patch) ---
POSTGRES_IMAGE=postgres:16.15
MYSQL_IMAGE=mysql:8.4.11
DORIS_FE_IMAGE=apache/doris:fe-3.1.4
DORIS_BE_IMAGE=apache/doris:be-3.1.4

# --- Application build/serve images ---
PYTHON_BASE_IMAGE=python:3.11.15-slim-bookworm
NODE_BASE_IMAGE=node:24.21.0-alpine
NGINX_IMAGE=nginx:1.29.8-alpine

# --- DataHub official release (v1.7.0.1, published 2026-09-03) ---
# Source of compose: datahub-project/datahub tag v1.7.0.1,
# docker/quickstart/docker-compose.quickstart-profile.yml (stored at
# infra/datahub/compose.pinned.yaml). Internal services are pinned by that
# official file: mysql:8.2, opensearchproject/opensearch:2.19.3,
# confluentinc/cp-kafka:8.2.2.
DATAHUB_VERSION=v1.7.0.1
DATAHUB_GMS_IMAGE=acryldata/datahub-gms:v1.7.0.1
DATAHUB_FRONTEND_IMAGE=acryldata/datahub-frontend-react:v1.7.0.1
DATAHUB_UPGRADE_IMAGE=acryldata/datahub-upgrade:v1.7.0.1
DATAHUB_ACTIONS_IMAGE=acryldata/datahub-actions:v1.7.0.1-slim
DATAHUB_INGESTION_IMAGE=acryldata/datahub-ingestion:v1.7.0.1

# --- Python dependencies (exact pins; uv.lock is the source of truth) ---
FASTAPI_VERSION=0.141.1
UVICORN_VERSION=0.52.4
PYDANTIC_VERSION=2.13.5
PYDANTIC_SETTINGS_VERSION=2.15.0
SQLALCHEMY_VERSION=2.0.52
ALEMBIC_VERSION=1.20.0
PSYCOPG_VERSION=3.3.5
PYMYSQL_VERSION=1.2.0
SQLGLOT_VERSION=30.18.0
ARGON2_CFFI_VERSION=25.1.0
PYARROW_VERSION=25.0.1

# --- Frontend dependencies (exact pins; package-lock.json is source of truth) ---
REACT_VERSION=19.3.0
VITE_VERSION=8.3.0
TYPESCRIPT_VERSION=5.9.3
TANSTACK_QUERY_VERSION=5.102.8
REACT_ROUTER_VERSION=7.18.3
OPENAPI_TYPESCRIPT_VERSION=7.13.0
