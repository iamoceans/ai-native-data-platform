<?xml version="1.0"?>
<!-- Spark Thrift Server client view of the shared Hive Metastore. The exact
     URIs and the warehouse dir are the ones the platform's Spark datasource
     registers as metastore_host/metastore_port. -->
<configuration>
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hive-metastore:9083</value>
  </property>
  <property>
    <name>hive.metastore.schema.verification</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>/opt/hive/data/warehouse</value>
  </property>
  <property>
    <name>hive.metastore.client.socket.timeout</name>
    <value>120</value>
  </property>
  <property>
    <name>hive.server2.thrift.port</name>
    <value>10000</value>
  </property>
  <property>
    <name>hive.server2.thrift.bind.host</name>
    <value>0.0.0.0</value>
  </property>
  <!-- The platform's first adapter release is NOSASL only (docs/runbook.md). -->
  <property>
    <name>hive.server2.authentication</name>
    <value>NOSASL</value>
  </property>
  <property>
    <name>hive.server2.enable.doAs</name>
    <value>false</value>
  </property>
</configuration>
