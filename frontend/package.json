{
  "name": "ainative-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:api && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run gen:api && tsc -b --noEmit",
