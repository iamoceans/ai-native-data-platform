# Copy to .env (`make setup-secrets` does this and fills random passwords).
# Never commit .env.
COMPOSE_PROJECT_NAME=ainative

# ---------------------------------------------------------------------------
# Pinned images (mirror of infra/versions.env; keep in sync)
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16.15
MYSQL_IMAGE=mysql:8.4.11
DORIS_FE_IMAGE=apache/doris:fe-3.1.4
DORIS_BE_IMAGE=apache/doris:be-3.1.4

# ---------------------------------------------------------------------------
# Control database (business state + task queue)
# ---------------------------------------------------------------------------
CONTROL_DB_NAME=ainative_control
CONTROL_DB_USER=ainative
CONTROL_DB_PASSWORD=__GENERATED__
CONTROL_DB_PORT=55432

# ---------------------------------------------------------------------------
# Source PostgreSQL (demo source database, M1 query target)
# ---------------------------------------------------------------------------
SOURCE_DB_NAME=ainative_source
SOURCE_DB_USER=source_reader
SOURCE_DB_PASSWORD=__GENERATED__
SOURCE_BOOTSTRAP_USER=source_admin
SOURCE_BOOTSTRAP_PASSWORD=__GENERATED__
SOURCE_DB_PORT=55433

# ---------------------------------------------------------------------------
# Source MySQL (M2, full profile)
# ---------------------------------------------------------------------------
MYSQL_SOURCE_DB=ainative_source
MYSQL_ADMIN_USER=source_admin
MYSQL_ADMIN_PASSWORD=__GENERATED__
MYSQL_READER_USER=source_reader
MYSQL_READER_PASSWORD=__GENERATED__
MYSQL_DB_PORT=33060

# ---------------------------------------------------------------------------
# Source Doris FE/BE (M2, full profile)
# ---------------------------------------------------------------------------
DORIS_ADMIN_USER=doris_admin
DORIS_ADMIN_PASSWORD=__GENERATED__
DORIS_READER_USER=doris_reader
DORIS_READER_PASSWORD=__GENERATED__
DORIS_FE_SQL_PORT=19030
DORIS_FE_HTTP_PORT=18030
DORIS_BE_HTTP_PORT=18040

# ---------------------------------------------------------------------------
# Application (see backend/app/config.py for the full list)
# ---------------------------------------------------------------------------
AIND_ENV=dev
AIND_LOG_LEVEL=INFO
AIND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AIND_COOKIE_SECURE=false
AIND_SOURCE_HOST_ALLOWLIST=localhost,127.0.0.1,source-postgres,source-mysql,doris-fe,control-postgres,host.docker.internal
AIND_GLOBAL_CONCURRENCY=4
AIND_PER_DATASOURCE_CONCURRENCY=2
AIND_PER_USER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Model endpoint (OpenAI-compatible). DeepSeek is the configured default:
# paste the API key into infra/local-secrets/llm_api_key (one line), keep the
# path below, then verify with `make llm-check`. Until a key is present the
# platform runs the deterministic template path and records a warning in the
# analysis state - it never pretends a model was called.
#
# AIND_LLM_RESPONSE_FORMAT: "json_object" (default) is the portable mode - the
# JSON schema travels in the prompt and the reply is validated against it.
# DeepSeek and most OpenAI-compatible servers reject "json_schema" with HTTP 400
# ("This response_format type is unavailable now"); set "json_schema" only for
# providers that implement strict structured outputs.
# ---------------------------------------------------------------------------
AIND_LLM_PROVIDER=openai-compatible
AIND_LLM_BASE_URL=https://api.deepseek.com/v1
AIND_LLM_MODEL=deepseek-chat
AIND_LLM_API_KEY_FILE=/run/secrets/llm_api_key
AIND_LLM_RESPONSE_FORMAT=json_object

# ---------------------------------------------------------------------------
# DataHub (M3)
# ---------------------------------------------------------------------------
DATAHUB_TOKEN_SERVICE_SALT=__GENERATED__
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=__GENERATED__
UI_INGESTION_DEFAULT_CLI_VERSION=1.7.0.10
DATAHUB_SYSTEM_CLIENT_SECRET=__GENERATED__
DATAHUB_VERSION=v1.7.0.1
DATAHUB_INGESTION_IMAGE=acryldata/datahub-ingestion:v1.7.0.1

# DataHub integration for the platform containers. Start the full profile with
# AIND_DATAHUB_ENABLED=1 once the DataHub stack is up (make up-full does this).
AIND_DATAHUB_ENABLED=0
AIND_DATAHUB_GMS_URL=http://datahub-gms:8080
AIND_DATAHUB_FRONTEND_URL=http://127.0.0.1:9002
# Optional bearer token; the quickstart runs with GMS auth disabled (leave empty).
AIND_DATAHUB_TOKEN=
AIND_INGESTION_VISIBILITY_TIMEOUT=60
